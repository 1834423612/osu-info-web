# Optional: override the browser-facing parking feed.
# NEXT_PUBLIC_GARAGE_API_URL=https://garageapi.campusparc.com/status

# Optional: override the upstream CABS content API used by route handlers.
# CABS_API_BASE=https://content.osu.edu/v2/bus

# Optional browser-visible NLR/AFDC key. The browser tries this official GET first.
# NEXT_PUBLIC_NLR_API_KEY=your_api_key

# Recommended private key for the same-origin /api/ev/stations fallback.
# It remains server-only. NLR_API_KEY wins over the public key and DEMO_KEY.
# NLR_API_KEY=your_private_api_key

# Optional trusted Tesla egress service for deployments whose public IP is denied
# by Tesla Akamai. The server sends GET <URL>?url=<encoded official Tesla URL> and
# expects the original JSON response. Never use NEXT_PUBLIC_ for either setting.
# TESLA_FETCH_PROXY_URL=https://trusted-egress.example/fetch
# TESLA_FETCH_PROXY_TOKEN=server_only_bearer_token
